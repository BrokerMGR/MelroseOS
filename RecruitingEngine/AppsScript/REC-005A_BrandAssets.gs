/**
 * MelroseOS Recruiting Automation Platform
 * Module: REC-005A_BrandAssets
 * Release: MOS5-021
 * Version: 1.0.0
 *
 * One-time seed of email-optimized MGR branding assets into Google Drive.
 * Asset IDs are stored in Script Properties and reused by the mailer.
 */

const REC_BRAND_ASSET_FOLDER = 'MelroseOS Recruiting Assets';
const REC_LOGO_JPEG_BASE64 = '';
const REC_CARD_JPEG_BASE64 = '';

function REC_getOrCreateBrandAssetFolder_() {
  const folders = DriveApp.getFoldersByName(REC_BRAND_ASSET_FOLDER);
  if (folders.hasNext()) return folders.next();
  return DriveApp.createFolder(REC_BRAND_ASSET_FOLDER);
}

function REC_seedBrandingAssets() {
  REC_assertSafeMode();

  const props = PropertiesService.getScriptProperties();
  const folder = REC_getOrCreateBrandAssetFolder_();

  const logoBlob = Utilities.newBlob(
    Utilities.base64Decode(REC_LOGO_JPEG_BASE64),
    'image/jpeg',
    'MGR-Recruiting-Logo.jpg'
  );

  const cardBlob = Utilities.newBlob(
    Utilities.base64Decode(REC_CARD_JPEG_BASE64),
    'image/jpeg',
    'Ulysses-Barnes-Broker-Business-Card.jpg'
  );

  const oldLogoId = props.getProperty('REC_LOGO_FILE_ID');
  const oldCardId = props.getProperty('REC_BUSINESS_CARD_FILE_ID');

  let logoFile;
  let cardFile;

  if (oldLogoId) {
    try {
      logoFile = DriveApp.getFileById(oldLogoId);
      logoFile.setContent(logoBlob.getDataAsString());
    } catch (err) {
      logoFile = null;
    }
  }

  if (!logoFile) {
    logoFile = folder.createFile(logoBlob);
  }

  if (oldCardId) {
    try {
      cardFile = DriveApp.getFileById(oldCardId);
      cardFile.setContent(cardBlob.getDataAsString());
    } catch (err) {
      cardFile = null;
    }
  }

  if (!cardFile) {
    cardFile = folder.createFile(cardBlob);
  }

  props.setProperty('REC_LOGO_FILE_ID', logoFile.getId());
  props.setProperty('REC_BUSINESS_CARD_FILE_ID', cardFile.getId());

  REC_log('PASS', 'REC-005A_BrandAssets', 'Brand assets seeded.', {
    folderId: folder.getId(),
    logoFileId: logoFile.getId(),
    businessCardFileId: cardFile.getId()
  });

  return REC_result(true, {
    folderId: folder.getId(),
    logoFileId: logoFile.getId(),
    businessCardFileId: cardFile.getId()
  });
}

function REC_getBrandAssetBlobs() {
  const props = PropertiesService.getScriptProperties();
  const logoId = props.getProperty('REC_LOGO_FILE_ID');
  const cardId = props.getProperty('REC_BUSINESS_CARD_FILE_ID');

  if (!logoId || !cardId) {
    throw new Error('Brand assets are not seeded. Run REC_seedBrandingAssets first.');
  }

  return {
    mgrLogo: DriveApp.getFileById(logoId).getBlob().setName('MGR-Recruiting-Logo.jpg'),
    brokerCard: DriveApp.getFileById(cardId).getBlob().setName('Ulysses-Barnes-Broker-Business-Card.jpg')
  };
}

function REC_runBrandAssetDiagnostics() {
  const props = PropertiesService.getScriptProperties();
  const logoId = props.getProperty('REC_LOGO_FILE_ID');
  const cardId = props.getProperty('REC_BUSINESS_CARD_FILE_ID');

  const checks = [
    { name: 'Logo file ID', pass: Boolean(logoId), detail: logoId || '' },
    { name: 'Business card file ID', pass: Boolean(cardId), detail: cardId || '' }
  ];

  if (logoId) {
    try {
      const f = DriveApp.getFileById(logoId);
      checks.push({ name: 'Logo readable', pass: f.getSize() > 0, detail: String(f.getSize()) });
    } catch (e) {
      checks.push({ name: 'Logo readable', pass: false, detail: e.message });
    }
  }

  if (cardId) {
    try {
      const f = DriveApp.getFileById(cardId);
      checks.push({ name: 'Business card readable', pass: f.getSize() > 0, detail: String(f.getSize()) });
    } catch (e) {
      checks.push({ name: 'Business card readable', pass: false, detail: e.message });
    }
  }

  return REC_result(
    checks.every(function(c) { return c.pass; }),
    { checks: checks }
  );
}
